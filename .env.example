# 董事长专属智能工作台 — 环境变量模板
# 复制为 .env 后填入真实值（勿提交 .env）

# 模型提供方：openai（本地/兼容接口，默认） | claude（Claude Agent SDK）
LLM_PROVIDER=openai

# ---- OpenAI 兼容接口（Ollama / vLLM / LM Studio / OneAPI 等）----
# 注意：需带 /v1 前缀（最终请求 {BASE}/chat/completions）
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:7b

# ---- Claude Agent SDK（仅 LLM_PROVIDER=claude 时需要）----
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- 汇讯 WiseUC（会议助手工具调用）----
# 默认模拟投递；实发时设 HUIXUN_ENABLED=true 并填写接口
HUIXUN_ENABLED=false
HUIXUN_BASE_URL=https://your-huixun-host
HUIXUN_APP_ID=
HUIXUN_APP_SECRET=
HUIXUN_SEND_PATH=/api/message/send

# 后端监听端口（Docker 内固定 3000）
PORT=3000

# ---- 本地 TTS（vLLM-Omni 镜像，Qwen3-TTS CustomVoice）----
# 百炼名 qwen-audio-3.1-tts-flash 无开源权重；本地用 Qwen3-TTS-12Hz-1.7B-CustomVoice
# 云端女声 yuxiaoyun_v3.1 映射为开源预设 vivian
TTS_SPEECH_URL=http://vllm-omni:8091
# 本机直接跑 backend 时改为：TTS_SPEECH_URL=http://127.0.0.1:8091
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_VOICE=yuxiaoyun_v3.1
VLLM_OMNI_IMAGE=vllm/vllm-omni-rocm:v0.28.0
# 显存紧张可改：Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# 启动：docker compose --profile vllm-omni up -d

# ---- 本地 ASR（sherpa-onnx，仍由 tts 服务提供）----
TTS_URL=http://host.docker.internal:8090

# ---- 运行时数据（默认挂载项目 ./data → 容器 /data）----
# HRBP_REPORT_DIR=/data/hrbp-reports
